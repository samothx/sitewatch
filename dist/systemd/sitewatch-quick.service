# sitewatch quick run (every 15 min: fixed pages, open issues, random sample). Unprivileged system user; only network + its
# state dir. Quick and full share a lock so state.json has one writer. Host bits (OnFailure=,
# groups) in sitewatch-quick.service.d/10-host.conf, written by install.sh.
[Unit]
Description=sitewatch: quick website check
Documentation=file:///usr/local/share/doc/sitewatch/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 3600 /var/lib/sitewatch/run.lock /usr/local/bin/sitewatch --config /etc/sitewatch/config.toml run --mode quick
User=sitewatch
Group=sitewatch
UMask=0027
TimeoutStartSec=20min
Nice=10
MemoryMax=512M

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/sitewatch -/var/spool/ntfy-dispatcher
